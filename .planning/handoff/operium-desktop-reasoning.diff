+// A tool loop produces one reasoning block per round, so every closed block
+// is collected; only the first used to be read, and later rounds' reasoning
+// leaked into the answer with its tags.
+export function splitReasoning(content) {
+  const parts = [];
+  let body = content.replace(/<think>([\s\S]*?)<\/think>/g, (match, text) => {
+    if (text.trim()) parts.push(text.trim());
+    return '';
+  });
+  let streamingThinking = false;
+  const open = body.lastIndexOf('<think>');
+  if (open >= 0) {
+    const tail = body.slice(open + '<think>'.length).trim();
+    if (tail) parts.push(tail);
+    body = body.slice(0, open);
+    streamingThinking = true;
+  }
+  // A model quoting the tag inside its reasoning leaves a stray closer.
+  body = body.replace(/<\/think>/g, '');
+  return {
+    thinking: parts.length ? parts.join('\n\n') : null,
+    streamingThinking,
+    body: body.trim(),
+  };
+}

